# Local database credentials. Set one strong password in your private .env,
# then place the URL-encoded form of the same password in both URLs below.
# The full stack exposes only the Web UI on 127.0.0.1 by default.
POSTGRES_USER=explorerag
POSTGRES_PASSWORD=
POSTGRES_DB=explorerag
DATABASE_URL_DOCKER=postgresql+asyncpg://explorerag:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/explorerag
DATABASE_URL=postgresql+asyncpg://explorerag:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5433/explorerag
POSTGRES_DEV_PORT=5433
CHROMA_DEV_PORT=8002
EXPLORERAG_HTTP_BIND_ADDRESS=127.0.0.1
EXPLORERAG_HTTP_PORT=5500

# Database and vector store endpoints for direct local development.
# Normally populated automatically by tools/build-with-fingerprint.ps1.
EXPLORERAG_BUILD_GIT_COMMIT=unknown
EXPLORERAG_BUILD_GIT_BRANCH=unknown
EXPLORERAG_BUILD_GIT_DIRTY=unknown
CHROMA_HOST=localhost
CHROMA_PORT=8002

# Qwen / Alibaba Cloud Model Studio
# Put the key only in your local .env; .env is ignored by Git.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_FAST=qwen-plus
# Optional independent Ragas judge. Use a model with reliable structured output.
EVALUATION_LLM_PROVIDER=workspace
EVALUATION_LLM_MODEL=
EVALUATION_LLM_MAX_TOKENS=8192
EVALUATION_LLM_MAX_ATTEMPTS=3
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_ENABLE_THINKING=false
LLM_MAX_OUTPUT_TOKENS=8192

# Local mode: Ollama exposes an OpenAI-compatible API inside Compose.
# Pull once with: docker exec explorerag-ollama ollama pull qwen3-vl:4b-instruct
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_NATIVE_BASE_URL=http://ollama:11434
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3-vl:4b-instruct
LOCAL_LLM_VISION_MODEL=qwen3-vl:4b-instruct
LOCAL_LLM_ENABLE_THINKING=false
LOCAL_LLM_CONTEXT_WINDOW=8192
LOCAL_LLM_MAX_OUTPUT_TOKENS=2048
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_HEALTH_TIMEOUT_SECONDS=3
LOCAL_LLM_REQUEST_TIMEOUT_SECONDS=600

# Local multilingual BAAI/bge-m3 and optional cross-encoder reranker.
# These paths are Windows host directories used by docker-compose mounts.
BGE_M3_MODEL_DIR=./bge-m3
BGE_RERANKER_MODEL_DIR=./bge-reranker-v2-m3
DOCLING_MODELS_DIR=./docling-models
# These are paths inside the backend container. For direct local Python runs,
# replace them with your absolute local BGE-M3 directory.
KG_EMBEDDING_PROVIDER=sentence_transformers
KG_EMBEDDING_MODEL=/models/bge-m3
KG_EMBEDDING_DIMENSION=1024
KG_EMBEDDING_DEVICE=cuda
EXPLORERAG_EMBEDDING_PROVIDER=sentence_transformers
EXPLORERAG_EMBEDDING_MODEL=/models/bge-m3
EXPLORERAG_EMBEDDING_DEVICE=cuda

# Fixed document and retrieval pipeline, orchestrated by LangChain/LCEL:
# Docling -> BGE-M3 -> LightRAG hybrid -> Qwen.
# Local timing/count callbacks only; no external tracing export.
EXPLORERAG_LANGCHAIN_LOCAL_CALLBACKS=true
EXPLORERAG_ENABLE_KG=true
# Workspace users can opt into query-time LightRAG evidence independently.
# These bounds keep a failed/large graph from delaying ordinary vector RAG.
EXPLORERAG_KG_AUGMENTATION_TIMEOUT_SECONDS=10
EXPLORERAG_KG_AUGMENTATION_MAX_CHARS=6000
EXPLORERAG_KG_AUGMENTATION_TOP_K=10
EXPLORERAG_KG_AUGMENTATION_CHUNK_TOP_K=5
EXPLORERAG_KG_LANGUAGE=Chinese
EXPLORERAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]
EXPLORERAG_DOCUMENT_PARSER=docling
EXPLORERAG_DOCLING_ARTIFACTS_PATH=/models/docling
EXPLORERAG_ENABLE_FORMULA_ENRICHMENT=false
EXPLORERAG_ENABLE_IMAGE_EXTRACTION=true
EXPLORERAG_ENABLE_IMAGE_CAPTIONING=true

# Download BAAI/bge-reranker-v2-m3 before setting this to true.
EXPLORERAG_ENABLE_RERANKER=false
EXPLORERAG_RERANKER_MODEL=/models/bge-reranker-v2-m3
EXPLORERAG_RERANKER_DEVICE=cuda
EXPLORERAG_RERANKER_DTYPE=float16
EXPLORERAG_RERANKER_MAX_LENGTH=768
EXPLORERAG_RERANKER_LONG_LIST_MAX_LENGTH=640
EXPLORERAG_RERANKER_LONG_LIST_THRESHOLD=16
EXPLORERAG_RERANKER_BATCH_SIZE=4
EXPLORERAG_RERANKER_TIMEOUT_SECONDS=5
EXPLORERAG_RERANKER_CIRCUIT_BREAKER_FAILURES=1
EXPLORERAG_RERANKER_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
EXPLORERAG_MODEL_WARMUP=true
EXPLORERAG_MODEL_WARMUP_TIMEOUT_SECONDS=120
EXPLORERAG_CHUNK_MAX_TOKENS=512
EXPLORERAG_EMBEDDING_BATCH_SIZE=4
EXPLORERAG_EMBEDDING_MAX_TOKENS=512
EXPLORERAG_EMBEDDING_TOKEN_OVERLAP=32
EXPLORERAG_CAPTION_MAX_WORKERS=3
EXPLORERAG_CAPTION_CACHE_SIZE=2048
EXPLORERAG_KB_PREFETCH=20
EXPLORERAG_KB_RERANK_TOP_K=4
EXPLORERAG_MIN_RELEVANCE_SCORE=0.15

# Ephemeral chat attachments. They are kept only until the workspace's
# existing "clear chat history" action is used; they never enter kb_* or KG.
CHAT_ATTACHMENT_MAX_COUNT=8
CHAT_ATTACHMENT_MAX_FILE_SIZE=26214400
CHAT_ATTACHMENT_MAX_PDF_PAGES=300
CHAT_ATTACHMENT_CONTEXT_WINDOW_TOKENS=32768
CHAT_ATTACHMENT_CONTEXT_SAFETY_TOKENS=2048
CHAT_ATTACHMENT_PREFETCH=20
CHAT_ATTACHMENT_RERANK_TOP_K=4
CHAT_ATTACHMENT_MAX_VISION_IMAGES=3
CHAT_ATTACHMENT_SCAN_TEXT_CHARS_PER_PAGE=40
CHAT_ATTACHMENT_SCAN_LOW_CONFIDENCE_CHARS=20
CHAT_ATTACHMENT_EAGER_INDEX_TOKENS=12000
CHAT_ATTACHMENT_PREPARE_TIMEOUT_SECONDS=600

# Pre-ingestion duplicate filter
EXPLORERAG_DEDUP_ENABLED=true
EXPLORERAG_DEDUP_MIN_CHUNK_LENGTH=50
EXPLORERAG_DEDUP_NEAR_THRESHOLD=0.85

CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
